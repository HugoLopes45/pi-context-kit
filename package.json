{
  "name": "pi-context-kit",
  "version": "0.2.1",
  "description": "Pi compaction and context management for the Pi coding agent: replace stale file reads, prune old tool outputs, prepare handoff notes in the background, and recall the original text.",
  "type": "module",
  "license": "MIT",
  "author": "HugoLopes45 (https://github.com/HugoLopes45)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugoLopes45/pi-context-kit.git"
  },
  "homepage": "https://github.com/HugoLopes45/pi-context-kit#readme",
  "bugs": {
    "url": "https://github.com/HugoLopes45/pi-context-kit/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "compaction",
    "context",
    "context-window",
    "context-management",
    "coding-agent",
    "llm",
    "handoff",
    "token-optimization"
  ],
  "files": [
    "extensions",
    "src"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && npm run lint && vitest --run",
    "lint": "node scripts/lint.ts",
    "test": "vitest --run",
    "prepublishOnly": "test -n \"$GITHUB_ACTIONS\" || test \"$(npm whoami)\" = hugolopes45 || { echo 'Publish only as the npm user hugolopes45.' >&2; exit 1; }; npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@types/node": "^26.6.4",
    "eslint": "^10.14.0",
    "typebox": "^1.3.27",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.8"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.8"
    }
  }
}
