{
  "name": "pi-context-kit",
  "version": "0.2.1",
  "description": "Keep long Pi coding agent sessions sharp. Clears old file reads and tool outputs from the context, writes the compaction summary in the background, and lets the agent recall the original text.",
  "type": "module",
  "license": "MIT",
  "author": "HugoLopes45 (https://github.com/HugoLopes45)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugoLopes45/pi-context-kit.git"
  },
  "homepage": "https://github.com/HugoLopes45/pi-context-kit#readme",
  "bugs": {
    "url": "https://github.com/HugoLopes45/pi-context-kit/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "compaction",
    "context",
    "context-window",
    "context-management",
    "coding-agent",
    "llm",
    "handoff",
    "token-optimization"
  ],
  "files": [
    "extensions",
    "src",
    "context-kit.schema.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && npm run lint && vitest --run",
    "lint": "node scripts/lint.ts",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^26.6.4",
    "eslint": "^10.14.0",
    "typebox": "^1.3.27",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.8"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.8"
    }
  }
}
